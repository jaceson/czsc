# Copy to a local .env file or export these variables in the service manager.
# Never commit real credentials.
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxx
FEISHU_MOBILE=13311566853

WEIBO_USERNAME=wu2198
# wu2198 defaults to 1778500695; set this explicitly if the account UID changes.
WEIBO_USER_ID=1778500695
WEIBO_POLL_INTERVAL=300
WEIBO_STATE_FILE=data/weibo_wu2198_state.json
# Optional: override the endpoint if Weibo changes its public mobile API.
# WEIBO_API_URL=https://m.weibo.cn/api/container/getIndex?type=uid&value={user_id}&containerid=107603{user_id}&page={page}
HTTP_TIMEOUT=20

# Optional official Weibo API OAuth 2.0 configuration.
# Register this exact callback URL in the Weibo app settings, then run:
#   python3 weibo_oauth.py authorize
#   python3 weibo_oauth.py callback '<full callback URL>'
WEIBO_CLIENT_ID=
WEIBO_CLIENT_SECRET=
WEIBO_REDIRECT_URI=http://127.0.0.1:8765/callback
WEIBO_TOKEN_FILE=data/weibo_oauth_token.json
